erDiagram
  tb_carts {
    int_unsigned ID PK
    int user_ID FK
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tb_logs {
    int ID PK
    varchar(100) table_name
    enum('Create','Read','Update','Delete') operation
    varchar(80) db_user
    text description
    datetime operation_date
    bit(1) operation_status
  }
  tb_products {
    int_unsigned id PK
    varchar(50) sku
    varchar(250) name
    text description
    decimal(10,2) current_price
    int_unsigned current_stock
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tb_seller_orders {
    int_unsigned ID PK
    int seller_ID FK
    decimal(12,2) subtotal
    decimal(12,2) shipping_cost
    enum('Pending','Accepted','Preparing','Sent','Delivered','Canceled','Returned') fulfillment_status
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tb_user_addresses {
    bigint_unsigned ID PK
    int user_ID FK
    varchar(100) address_label
    varchar(150) recipient_name
    varchar(25) recipient_phone
    varchar(500) delivery_instructions
    decimal(10,7) latitude
    decimal(10,7) longitude
    tinyint(1) is_default
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tb_users {
    int ID PK
    varchar(80) email
    varchar(100) nickname
    varchar(255) password
    datetime creation_date
    datetime last_update
    datetime last_login
    bit(1) status
  }
  tbc_categories {
    int_unsigned ID PK
    varchar(120) name
    text description
    int_unsigned sup_id_category FK
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tbc_payment_methods_types {
    int_unsigned ID PK
    varchar(30) code
    text description
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tbd_address_components {
    bigint_unsigned ID PK
    bigint_unsigned address_ID FK
    varchar(255) value
    varchar(50) component_type
    bit(1) status
    bigint_unsigned address_sup_ID FK
    datetime creation_date
    datetime last_update
  }
  tbd_cart_items {
    int_unsigned cart_ID PK
    int provider_ID PK
    int_unsigned product_ID PK
    int_unsigned quantity
    datetime creation_date
  }
  tbd_order_items {
    int_unsigned ID PK
    int_unsigned seller_order_ID FK
    int_unsigned product_ID FK
    int provider_ID FK
    varchar(255) product_name
    int_unsigned quantity
    decimal(12,2) unit_price
    decimal(12,2) subtotal
    datetime creation_date
  }
  tbd_products_categories {
    int_unsigned category_ID PK
    int_unsigned product_ID PK
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tbd_products_users_providers {
    int user_ID PK
    int_unsigned product_ID PK
    enum('Owner','Reseller','Distributor') type_ownership
    bit(1) status
    datetime available_date
    datetime creation_date
    datetime last_update
  }
  tbd_user_payment_methods {
    bigint_unsigned ID PK
    int user_ID FK
    int_unsigned payment_method_type_ID FK
    varchar(60) provider
    varchar(255) provider_method_ref
    varchar(100) label
    char(4) last_four
    tinyint(1) is_default
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tbd_users_wishlist_products {
    int user_ID PK
    int_unsigned product_ID PK
    bit(1) status
    datetime creation_date
    datetime last_update
  }
  tb_users ||--o{ tb_carts : "user_ID"
  tb_users ||--o{ tb_seller_orders : "seller_ID"
  tb_users ||--o{ tb_user_addresses : "user_ID"
  tbc_categories ||--o{ tbc_categories : "sup_id_category"
  tb_user_addresses ||--o{ tbd_address_components : "address_ID"
  tbd_address_components ||--o{ tbd_address_components : "address_ID,address_sup_ID"
  tb_carts ||--o{ tbd_cart_items : "cart_ID"
  tbd_products_users_providers ||--o{ tbd_cart_items : "provider_ID"
  tbd_products_users_providers ||--o{ tbd_cart_items : "product_ID"
  tb_seller_orders ||--o{ tbd_order_items : "seller_order_ID"
  tbd_products_users_providers ||--o{ tbd_order_items : "product_ID"
  tbd_products_users_providers ||--o{ tbd_order_items : "provider_ID"
  tbc_categories ||--o{ tbd_products_categories : "category_ID"
  tb_products ||--o{ tbd_products_categories : "product_ID"
  tb_products ||--o{ tbd_products_users_providers : "product_ID"
  tb_users ||--o{ tbd_products_users_providers : "user_ID"
  tb_users ||--o{ tbd_user_payment_methods : "user_ID"
  tbc_payment_methods_types ||--o{ tbd_user_payment_methods : "payment_method_type_ID"
  tb_products ||--o{ tbd_users_wishlist_products : "product_ID"
  tb_users ||--o{ tbd_users_wishlist_products : "user_ID"
